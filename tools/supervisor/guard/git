#!/bin/sh
# Supervisor guard, first on the PATH of `supervise present` validations.
# Refuses push and tag creation; the rules live in rules.cjs, shared with the
# child_process hook. Fails closed: no node, no call.
guard_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo "supervisor guard: node not found, git refused" >&2; exit 127; }
exec node "$guard_dir/run.mjs" git "$@"
