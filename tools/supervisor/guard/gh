#!/bin/sh
# Supervisor guard, first on the PATH of `supervise present` validations.
# Refuses what publishes (release writes, workflow dispatch, pull request
# merge, API writes); the rules live in rules.cjs, shared with the
# child_process hook. Fails closed: no node, no call.
guard_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
command -v node >/dev/null 2>&1 || { echo "supervisor guard: node not found, gh refused" >&2; exit 127; }
exec node "$guard_dir/run.mjs" gh "$@"
