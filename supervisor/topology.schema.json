{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://github.com/RebelliousSmile/obsidian-handbook/supervisor/topology.schema.json",
	"title": "Supervisor topology",
	"type": "object",
	"additionalProperties": false,
	"required": ["version", "repos"],
	"properties": {
		"$schema": { "type": "string" },
		"version": { "const": 1 },
		"repos": {
			"type": "array",
			"minItems": 1,
			"items": { "$ref": "#/definitions/repo" }
		}
	},
	"definitions": {
		"commands": {
			"type": "array",
			"items": {
				"type": "array",
				"minItems": 1,
				"items": { "type": "string", "minLength": 1 }
			}
		},
		"id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
		"repo": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "path", "repository", "role", "trainFiles"],
			"properties": {
				"id": { "$ref": "#/definitions/id" },
				"path": { "type": "string", "pattern": "^[^/.][^/]*$" },
				"repository": { "type": "string", "pattern": "^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$" },
				"role": { "enum": ["coordinator", "provider", "consumer"] },
				"package": { "type": "string", "minLength": 1 },
				"adapter": { "enum": ["pbta", "adrenaline", "mist"] },
				"consumers": {
					"type": "array",
					"uniqueItems": true,
					"items": { "$ref": "#/definitions/id" }
				},
				"trainFiles": {
					"type": "array",
					"minItems": 1,
					"uniqueItems": true,
					"items": { "type": "string", "pattern": "^[^/.][^\\s]*$" }
				},
				"matrix": { "type": "string", "pattern": "^[^/.][^\\s]*$" },
				"release": {
					"description": "How a consumer publishes its release: its workflow starts on the push of the tag v<version> (tag), or is dispatched on that tag (dispatch).",
					"type": "object",
					"additionalProperties": false,
					"required": ["trigger", "workflow"],
					"properties": {
						"trigger": { "enum": ["tag", "dispatch"] },
						"workflow": { "type": "string", "pattern": "^[^/\\s]+\\.ya?ml$" }
					}
				},
				"validations": { "$ref": "#/definitions/commands" },
				"rehearsal": {
					"description": "Provider only. The static proofs of its train workflow, played in its checkout before its train manifest is landed and before the workflow is dispatched. `{manifest}` stands for the path of the manifest, and every command names it.",
					"$ref": "#/definitions/commands"
				},
				"convergence": { "$ref": "#/definitions/commands" }
			},
			"if": { "properties": { "role": { "const": "provider" } } },
			"then": { "required": ["package", "adapter", "consumers"], "not": { "required": ["release"] } },
			"else": {
				"not": {
					"anyOf": [
						{ "required": ["adapter"] },
						{ "required": ["consumers"] },
						{ "required": ["package"] }
					]
				}
			}
		}
	}
}
