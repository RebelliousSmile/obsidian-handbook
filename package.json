{
	"name": "obsidian-handbook",
	"version": "2.22.0",
	"description": "Game-specific themes and tools for Obsidian tabletop roleplaying vaults.",
	"main": "dist/main.js",
	"packageManager": "pnpm@10.5.2",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"dev:schema-pbta": "node tools/dev-schema-source.mjs --source ../schema-pbta",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"check": "node tools/check.mjs",
		"lint": "eslint .",
		"assert:corpus": "node tools/assert-corpus.mjs",
		"assert:ci-install": "node tools/assert-ci-install.mjs",
		"assert:release-version": "node tools/assert-release-version.mjs",
		"dump:dom": "node tools/dump-dom.mjs",
		"assert:override": "node tools/assert-override.mjs",
		"assert:game-storage": "node tools/assert-game-storage.mjs",
		"assert:github-sources": "node tools/assert-github-sources.mjs",
		"assert:custom-packs": "node tools/assert-custom-packs.mjs",
		"assert:mist-font-packs": "node tools/assert-mist-font-packs.mjs",
		"assert:repository-manifest": "node tools/assert-repository-manifest.mjs",
		"assert:source-installer": "node tools/assert-source-installer.mjs",
		"assert:starter-kits": "node tools/assert-starter-kits.mjs",
		"e2e:request-url": "bash tools/e2e/request-url-journey.sh",
		"e2e:layout-regions": "powershell -ExecutionPolicy Bypass -File tools/e2e/layout-regions-journey.ps1",
		"e2e:layout-regions:linux": "bash tools/e2e/layout-regions-journey.sh",
		"assert:game-variants": "node tools/assert-game-variants.mjs",
		"assert:otherscape-primitives": "node tools/assert-otherscape-primitives.mjs",
		"assert:otherscape-theme": "node tools/assert-otherscape-theme.mjs",
		"assert:adrenaline-documents": "node tools/assert-adrenaline-documents.mjs",
		"assert:adrenaline-contract": "node tools/assert-adrenaline-contract.mjs",
		"assert:adrenaline-source": "node tools/assert-adrenaline-source.mjs",
		"assert:adrenaline-theme": "node tools/assert-adrenaline-theme.mjs",
		"assert:adrenaline-zombiology-style": "node tools/assert-adrenaline-zombiology-style.mjs",
		"assert:pbta-theme": "node tools/assert-pbta-theme.mjs",
		"assert:pbta-contract": "node tools/assert-pbta-contract.mjs",
		"assert:pbta-specialized-projection": "node tools/assert-pbta-specialized-projection.mjs",
		"assert:pbta-pack-coverage": "node tools/assert-pbta-pack-coverage.mjs",
		"assert:settings-ui": "node tools/assert-settings-ui.mjs",
		"assert:reload-styles": "node tools/assert-reload-styles.mjs",
		"assert:style-scope": "node tools/assert-style-scope.mjs",
		"assert:tag-widget": "node tools/assert-tag-widget.mjs",
		"assert:city-v1-theme": "node tools/assert-city-v1-theme.mjs",
		"assert:callouts": "node tools/assert-callouts.mjs",
		"assert:note-background": "node tools/assert-note-background.mjs",
		"assert:layout-regions": "node tools/assert-layout-regions.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"assert:mist-contract": "node tools/assert-mist-contract.mjs",
		"assert:consumer-schema-pins": "node tools/assert-consumer-schema-pins.mjs",
		"assert:provider-capabilities": "node tools/assert-provider-capabilities.mjs",
		"assert:game-pack-contract": "node tools/assert-game-pack-contract.mjs",
		"assert:contextual-toml-export": "node tools/assert-contextual-toml-export.mjs",
		"assert:contextual-pack-blocks": "node tools/assert-contextual-pack-blocks.mjs"
	},
	"keywords": [
		"city of mist",
		"legend in the mist",
		"adrenaline system",
		"ttrpg",
		"roleplaying",
		"game"
	],
	"author": "François-Xavier Guillois",
	"license": "MIT",
	"dependencies": {
		"obsidian": "^1.12.3",
		"postcss": "8.5.28",
		"postcss-selector-parser": "7.1.6",
		"schema-adrenaline": "https://github.com/RebelliousSmile/schema-adrenaline/releases/download/v2.0.0/schema-adrenaline-2.0.0.tgz",
		"schema-in-the-mist": "https://github.com/RebelliousSmile/schema-in-the-mist/releases/download/v1.3.4/schema-in-the-mist-1.3.4.tgz",
		"schema-pbta": "https://github.com/RebelliousSmile/schema-pbta/releases/download/v8.1.0/schema-pbta-8.1.0.tgz",
		"smol-toml": "^1.8.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.30.1",
		"@types/node": "^16.18.126",
		"@typescript-eslint/parser": "^8.69.0",
		"ajv": "6.12.6",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.0",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^9.30.1",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-obsidianmd": "0.2.9",
		"globals": "^17.5.0",
		"obsidian": "^1.12.3",
		"sass": "^1.99.0",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2"
	}
}
