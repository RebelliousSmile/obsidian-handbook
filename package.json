{
	"name": "obsidian-handbook",
	"version": "2.2.1",
	"description": "Theme and tools for Son of Oak's TTRPGs: City of Mist, Legend in the Mist and :Otherscape.",
	"main": "dist/main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs --watch",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"assert:corpus": "node tools/assert-corpus.mjs",
		"dump:dom": "node tools/dump-dom.mjs",
		"assert:override": "node tools/assert-override.mjs",
		"assert:game-variants": "node tools/assert-game-variants.mjs",
		"assert:otherscape-primitives": "node tools/assert-otherscape-primitives.mjs",
		"assert:settings-ui": "node tools/assert-settings-ui.mjs",
		"assert:style-scope": "node tools/assert-style-scope.mjs",
		"assert:tag-widget": "node tools/assert-tag-widget.mjs",
		"assert:city-v1-theme": "node tools/assert-city-v1-theme.mjs",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"city of mist",
		"legend in the mist",
		"ttrpg",
		"roleplaying",
		"game"
	],
	"author": "François-Xavier Guillois",
	"license": "MIT",
	"dependencies": {
		"obsidian": "^1.12.3",
		"smol-toml": "^1.8.0"
	},
	"devDependencies": {
		"@codemirror/state": "6.5.0",
		"@codemirror/view": "6.38.6",
		"@eslint/js": "^9.30.1",
		"@types/node": "^16.18.126",
		"@typescript-eslint/parser": "^8.69.0",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.28.0",
		"esbuild-sass-plugin": "^3.7.0",
		"eslint": "^9.30.1",
		"eslint-plugin-no-unsanitized": "^4.1.5",
		"eslint-plugin-obsidianmd": "^0.2.3",
		"globals": "^17.5.0",
		"obsidian": "^1.12.3",
		"sass": "^1.99.0",
		"tslib": "2.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.58.2"
	}
}
